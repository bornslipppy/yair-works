{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": [
          {
            "element": "button",
            "message": "Use <Button> from the design system instead of <button>."
          },
          {
            "element": "input",
            "message": "Use <Checkbox> from the design system instead of <input>."
          },
          {
            "element": "dialog",
            "message": "Use <Dialog> from the design system instead of <dialog>."
          },
          {
            "element": "form",
            "message": "Use <Form> from the design system instead of <form>."
          },
          {
            "element": "input",
            "message": "Use <Input> from the design system instead of <input>."
          },
          {
            "element": "select",
            "message": "Use <Select> from the design system instead of <select>."
          },
          {
            "element": "input",
            "message": "Use <Slider> from the design system instead of <input>."
          },
          {
            "element": "table",
            "message": "Use <Table> from the design system instead of <table>."
          },
          {
            "element": "textarea",
            "message": "Use <Textarea> from the design system instead of <textarea>."
          }
        ]
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/arc-shell/PageHeader/**",
              "components/components/Accordion/**",
              "components/components/AddressInput/**",
              "components/components/Alert/**",
              "components/components/AlertDialog/**",
              "components/components/Avatar/**",
              "components/components/Badge/**",
              "components/components/Breadcrumb/**",
              "components/components/Button/**",
              "components/components/ButtonGroup/**",
              "components/components/Calendar/**",
              "components/components/Card/**",
              "components/components/Carousel/**",
              "components/components/ChartContainer/**",
              "components/components/Checkbox/**",
              "components/components/CheckboxCard/**",
              "components/components/Collapsible/**",
              "components/components/Combobox/**",
              "components/components/Dialog/**",
              "components/components/Drawer/**",
              "components/components/DropdownMenu/**",
              "components/components/Fade/**",
              "components/components/Form/**",
              "components/components/IconButton/**",
              "components/components/Input/**",
              "components/components/InputGroup/**",
              "components/components/Label/**",
              "components/components/Logo/**",
              "components/components/NavigationMenu/**",
              "components/components/NumberInput/**",
              "components/components/PageSpinner/**",
              "components/components/Pagination/**",
              "components/components/PhoneNumberInput/**",
              "components/components/Popover/**",
              "components/components/Progress/**",
              "components/components/RadioCard/**",
              "components/components/RadioGroup/**",
              "components/components/Select/**",
              "components/components/Separator/**",
              "components/components/Sheet/**",
              "components/components/SideMenu/**",
              "components/components/Skeleton/**",
              "components/components/Slider/**",
              "components/components/Spinner/**",
              "components/components/Status/**",
              "components/components/Stepper/**",
              "components/components/Switch/**",
              "components/components/Table/**",
              "components/components/Tabs/**",
              "components/components/Tag/**",
              "components/components/Textarea/**",
              "components/components/TimeInput/**",
              "components/components/Tip/**",
              "components/components/Toast/**",
              "components/components/ToggleGroup/**",
              "components/components/Tooltip/**",
              "components/components/Wizard/**",
              "components/layout/Container/**",
              "components/layout/Grid/**",
              "components/layout/Stack/**",
              "components/typography/Heading/**",
              "components/typography/Text/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "JSXOpeningElement[name.name='AddressInput'] > JSXAttribute > JSXIdentifier[name!=/^(?:apiKey|onError|value|input|inputOffset|placeholder|onAutocomplete|showClearButton|showLocationButton|disabled|className|styles|componentRestrictions|region|loadingText|clearInputText|onClear|id|style|children|key|ref|className|style|children)$/]",
        "message": "<AddressInput> doesn't accept that prop. Declared props: apiKey, onError, value, input, inputOffset, placeholder, onAutocomplete, showClearButton, showLocationButton, disabled, className, styles, componentRestrictions, region, loadingText, clearInputText, onClear, id, style, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Alert'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|className|showIcon|icon|dismissible|defaultOpen|open|onOpenChange|id|style|children|key|ref|className|style|children)$/]",
        "message": "<Alert> doesn't accept that prop. Declared props: variant, className, showIcon, icon, dismissible, defaultOpen, open, onOpenChange, id, style, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Alert'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:neutral|information|success|warning|critical)$/]",
        "message": "<Alert> variant must be one of 'neutral' | 'information' | 'success' | 'warning' | 'critical'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:className|id|style|children|size|variant|align|asChild|isLoading|icon|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: className, id, style, children, size, variant, align, asChild, isLoading, icon."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:icon|default|sm|lg|icon-sm)$/]",
        "message": "<Button> size must be one of 'icon' | 'default' | 'sm' | 'lg' | 'icon-sm'."
